{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "worker": true
  },
  "overrides": [
    {
      "files": [
        "**/*.astro"
      ],
      "rules": {
        "unicorn/prefer-add-event-listener": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".astro"
  ]
}