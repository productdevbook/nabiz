{
  "name": "nabiz",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "description": "A status page that keeps beating when your server does not — one Cloudflare Worker, or one container you own.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:server": "NABIZ_TARGET=node astro build",
    "start": "bun src/server/index.ts",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.edge.json",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && oxfmt --check src test && bun test"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.4",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "happy-dom": "^20.11.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "astro": "^7.2.1"
  }
}
