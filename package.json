{
  "name": "nabiz",
  "version": "1.1.0",
  "private": true,
  "description": "A status page that keeps beating when your server does not \u2014 Cloudflare Worker + cron + D1.",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "check": "bun run typecheck && bun run lint && oxfmt --check src && bun test",
    "test": "bun test",
    "css": "tailwindcss -i src/styles.css -o src/styles.built.css --minify"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@tailwindcss/cli": "^4.3.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  }
}