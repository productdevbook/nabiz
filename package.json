{
  "name": "nabiz",
  "version": "2.0.0",
  "private": true,
  "description": "A status page that keeps beating when your server does not — Cloudflare Worker + cron + D1.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && oxfmt --check src test && bun test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "astro": "^7.2.0"
  }
}