---
import "../styles.css"
import { env } from "cloudflare:workers"
import { statusJson } from "../lib/api.ts"
import { langOf, NAMES, t, type Lang } from "../lib/i18n.ts"
import { callout, eventLine, pastNotice, serviceRow, when } from "../lib/render.ts"
import { eventsView, overall, rows } from "../lib/shape.ts"
import { forPage, notices, recentEvents } from "../lib/store.ts"

const lang = langOf(Astro.url.searchParams.get("lang") || env.LANG)
const title = env.TITLE ?? "nabiz"

const data = await forPage(env.DB, 90)
// Read wide, shown narrow: a group's members write an event each and
// the view collapses them, so a slice of ten rows could collapse to one.
const events = await recentEvents(env.DB, 120)

// An agent that asks for JSON gets the JSON, no second request needed.
const accept = Astro.request.headers.get("accept") ?? ""
if (accept.includes("application/json") && !accept.includes("text/html"))
  return statusJson(data, events)

const noticeList = await notices(env.DB, 3, lang)

const list = rows(data)
const state = overall(list)
const banner =
  state === "up"
    ? "all_up"
    : state === "down"
      ? "all_down"
      : state === "sites"
        ? "sites_down"
        : "some_down"
const bannerClass = state === "up" ? "ok" : state === "down" ? "bad" : "meh"
const openNotices = noticeList.filter((n) => n.resolved_at === null)
const pastNotices = noticeList.filter((n) => n.resolved_at !== null)
const eventItems = eventsView(data.monitors, events, data.states, 10)
const LANGS: Lang[] = ["en", "tr", "de", "es", "fr"]

Astro.response.headers.set("cache-control", "public, max-age=0, s-maxage=15")
Astro.response.headers.set("x-status", state)
Astro.response.headers.set(
  "link",
  '</llms.txt>; rel="llms-txt", </api/status.json>; rel="alternate"; type="application/json", </feed.xml>; rel="alternate"; type="application/rss+xml"',
)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={`${title} · ${t(lang, "foot_tag")}`} />
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" />
    <link rel="alternate" type="application/json" href="/api/status.json" />
    <link rel="llms-txt" type="text/plain" href="/llms.txt" />
    <script is:inline>
      // Before first paint, or the page flashes the wrong theme.
      try {
        var t = localStorage.getItem("nabiz-theme")
        if (t) document.documentElement.dataset.theme = t
      } catch {}
    </script>
  </head>
  <body>
    <div class="top">
      <div class="brand">
        <span class="mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
            <path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"></path>
          </svg>
        </span>
        <h1>{title}</h1>
      </div>
      <div class="ctrl">
        <button id="theme" type="button" aria-label={t(lang, "aria_theme")} aria-pressed="false">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
        <select id="lang" aria-label={t(lang, "aria_lang")}>
          {LANGS.map((l) => <option value={l} selected={l === lang}>{NAMES[l]}</option>)}
        </select>
      </div>
    </div>

    <p id="say" class="sr" aria-live="polite" aria-atomic="true"></p>
    <main>
    <div class:list={["card", "hero", bannerClass]}>
      <span class:list={["dot", bannerClass]} aria-hidden="true">
        {
          bannerClass === "ok" ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 6v7" />
              <path d="M12 17.5h.01" />
            </svg>
          )
        }
      </span>
      <div class="hero-t">
        <p class="hero-s">{t(lang, banner)}</p>
        <p class="hero-m">{t(lang, "updated")} · {when(Date.now())}</p>
      </div>
      <svg class="ekg" viewBox="0 0 600 44" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0 26 H236 L246 20 L254 30 L262 26 H298 L306 26 L314 4 L326 42 L336 26 H600"
          pathLength="1"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"></path>
      </svg>
    </div>

    <Fragment set:html={openNotices.map((n) => callout(n, lang)).join("\n")} />

    <section class="panel">
      <header class="panel-h"><h2>{t(lang, "services")}</h2><a href="/api/status.json" title="status.json"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1"></path></svg></a></header>
      <div class="well">
        <Fragment set:html={list.map((r) => serviceRow(r, lang)).join("\n")} />
      </div>
    </section>

    {
      pastNotices.length > 0 && (
        <>
          <section class="panel">
            <header class="panel-h"><h2>{t(lang, "notices")}</h2><a href="/api/notices.json" title="notices.json"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1"></path></svg></a></header>
            <div class="well stack">
              <Fragment set:html={pastNotices.map((n) => pastNotice(n, lang)).join("\n")} />
            </div>
          </section>
        </>
      )
    }

    {
      eventItems.length > 0 && (
        <>
          <section class="panel">
            <header class="panel-h"><h2>{t(lang, "recent_events")}</h2><a href="/feed.xml" title="RSS"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1.6" fill="currentColor" stroke="none"></circle></svg></a></header>
            <ul class="well events">
              <Fragment set:html={eventItems.map((e) => eventLine(e, lang)).join("\n")} />
            </ul>
          </section>
        </>
      )
    }

    </main>

    <footer class="foot">
      <div class="foot-grid">
        <div class="foot-brand">
          <span class="mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
              <path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"></path>
            </svg>
          </span>
          <div>
            <strong>{title}</strong>
            <p>{t(lang, "foot_tag")}</p>
          </div>
        </div>
        <nav class="foot-col" aria-label="API">
          <h3>API</h3>
          <a href="/api/status.json">status.json</a>
          <a href="/api/history.json">history.json</a>
          <a href="/api/notices.json">notices.json</a>
          <a href="/badge.svg">badge.svg</a>
        </nav>
        <nav class="foot-col" aria-label={t(lang, "foot_follow")}>
          <h3>{t(lang, "foot_follow")}</h3>
          <a href="/feed.xml">RSS</a>
          <a href="/llms.txt">llms.txt</a>
          <a href="https://github.com/productdevbook/nabiz">GitHub</a>
        </nav>
      </div>
      <div class="foot-base">
        <span>{t(lang, "updated")} · {when(Date.now())}</span>
        <a href="#notice" id="pen" title={t(lang, "ed_title")}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"></path>
            <path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"></path>
          </svg>
        </a>
      </div>
    </footer>

    <dialog id="ed" aria-labelledby="ed-t">
      <h3 id="ed-t">{t(lang, "ed_title")}</h3>
      <div class="seg" id="sev" role="radiogroup" aria-label={t(lang, "aria_severity")}>
        {
          (["info", "maintenance", "degraded", "outage"] as const).map((v, i) => (
            <button
              type="button"
              role="radio"
              aria-checked={i === 0 ? "true" : "false"}
              data-v={v}
              class:list={[{ on: i === 0 }, v]}
            >
              {t(lang, `sev_${v}`)}
            </button>
          ))
        }
      </div>
      <textarea id="txt" rows="6" placeholder={t(lang, "ed_body")}></textarea>
      <div class="pair">
        <select id="nlang" aria-label={t(lang, "aria_notice_lang")}>
          <option value="all">{t(lang, "ed_lang_all")}</option>
          {LANGS.map((l) => <option value={l} selected={l === lang}>{NAMES[l]}</option>)}
        </select>
        <input id="tok" type="password" placeholder={t(lang, "ed_token")} autocomplete="off" />
      </div>
      <div id="resolvables"></div>
      <p id="ederr" class="ederr" role="alert"></p>
      <footer>
        <button id="cancel" type="button">{t(lang, "ed_cancel")}</button>
        <button id="pub" type="button" class="primary">{t(lang, "ed_publish")}</button>
      </footer>
    </dialog>

    <script
      is:inline
      define:vars={{
        resolveLabel: t(lang, "ed_resolve"),
        failedLabel: t(lang, "ed_failed"),
        throttledLabel: t(lang, "ed_throttled"),
        rejectedLabel: t(lang, "ed_rejected"),
        offlineLabel: t(lang, "ed_offline"),
      }}
    >
      var dlg, tok, err, pub
      // Kept out of the swap: a live region that is a new node every tick
      // is a live region a reader may never hear.
      var live = document.getElementById("say")
      var sev = "info"
      var sending = false
      function wire() {
        dlg = document.getElementById("ed")
        if (!dlg) return
        tok = document.getElementById("tok")
        err = document.getElementById("ederr")
        pub = document.getElementById("pub")
        // The session, not forever: an operator's token left in a browser
        // is a publish button for whoever sits down next.
        tok.value = sessionStorage.getItem("nabiz-token") || ""
        var segs = Array.prototype.slice.call(document.querySelectorAll("#sev button"))
        var pick = function (b, focus) {
          segs.forEach(function (x) {
            var on = x === b
            x.classList.toggle("on", on)
            x.setAttribute("aria-checked", String(on))
            // One stop in the tab order for the group, as a radio group has.
            x.tabIndex = on ? 0 : -1
          })
          sev = b.dataset.v
          if (focus) b.focus()
        }
        // The body is rebuilt with the first severity selected, so what
        // the page shows is the truth and the script follows it.
        var shown = segs.find(function (b) { return b.classList.contains("on") })
        sev = shown ? shown.dataset.v : "info"
        segs.forEach(function (b, i) {
          b.tabIndex = b.classList.contains("on") ? 0 : -1
          b.onclick = function () { pick(b) }
          b.onkeydown = function (e) {
            var step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1
              : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0
            if (!step) return
            e.preventDefault()
            pick(segs[(i + step + segs.length) % segs.length], true)
          }
        })
        pub.onclick = publish
        document.getElementById("cancel").onclick = function () { dlg.close() }
        var ls = document.getElementById("lang")
        if (ls) {
          // A select changes as it is walked through — by arrow key and by
          // typing a letter — and navigating on that means a keyboard user
          // cannot read the list at all. A pointer picking an option is a
          // decision; a keyboard one is not until Enter or leaving.
          var picked = false
          var chosen = ls.value
          var commit = function () { if (ls.value !== chosen) go(ls.value) }
          ls.onfocus = function () { chosen = ls.value }
          ls.onpointerdown = function () { picked = true }
          ls.onkeydown = function (e) { if (e.key === "Enter") { e.preventDefault(); go(ls.value) } }
          ls.onchange = function () { if (picked) { picked = false; go(ls.value) } }
          // A refresh takes this element out of the page, and the blur that
          // fires on the way out is not somebody choosing a language.
          ls.onblur = function () { picked = false; if (ls.isConnected) commit() }
        }
        var pen = document.getElementById("pen")
        if (pen) pen.onclick = function (e) { e.preventDefault(); openEd() }
        var th = document.getElementById("theme")
        if (th) {
          th.onclick = toggleTheme
          th.setAttribute("aria-pressed", String(isDark()))
        }
      }
      function go(v) {
        // Against what the page is written in, not against the query — the
        // default entry has no lang in it and every blur would be a change.
        if (v && v !== document.documentElement.lang) location.search = "?lang=" + v
      }
      function openEd() {
        if (dlg.open) return
        var box = document.getElementById("resolvables")
        box.replaceChildren()
        document.querySelectorAll("[data-open]").forEach(function (n) {
          var b = document.createElement("button")
          b.type = "button"
          b.className = "res"
          b.textContent = resolveLabel + " · #" + n.dataset.notice
          b.onclick = function () { send("/api/notice/resolve", { id: Number(n.dataset.notice) }, b) }
          box.appendChild(b)
        })
        dlg.showModal()
        document.getElementById("txt").focus()
      }
      function send(path, body, from) {
        if (sending) return
        var button = from || pub
        sending = true
        button.disabled = true
        button.setAttribute("aria-busy", "true")
        err.textContent = ""
        var done = function () {
          sending = false
          button.disabled = false
          button.removeAttribute("aria-busy")
        }
        fetch(path, {
          method: "POST",
          headers: { "content-type": "application/json", authorization: "Bearer " + tok.value },
          body: JSON.stringify(body),
        })
          .then(function (r) {
            if (r.ok) {
              sessionStorage.setItem("nabiz-token", tok.value)
              // Whoever was reading this page in French is still reading it
              // in French after publishing.
              location.href = location.pathname + location.search
              return
            }
            done()
            // Three refusals that are not the same refusal: the token was
            // wrong, there have been too many tries, or the notice itself
            // was not acceptable.
            err.textContent = r.status === 429 ? throttledLabel : r.status === 401 ? failedLabel : rejectedLabel
            if (r.status === 401) sessionStorage.removeItem("nabiz-token")
          })
          .catch(function () {
            done()
            // The connection you have during the outage you are announcing.
            err.textContent = offlineLabel
          })
      }
      function publish() {
        send("/api/notice", {
          severity: sev,
          lang: document.getElementById("nlang").value,
          body: document.getElementById("txt").value,
        })
      }
      addEventListener("keydown", function (e) {
        var tag = (document.activeElement || {}).tagName
        if ((e.key === "n" || e.key === "N") && !e.metaKey && !e.ctrlKey && tag !== "INPUT" && tag !== "TEXTAREA" && tag !== "SELECT") {
          // Without this the very keystroke that opens the editor types
          // itself into whichever field lands the focus.
          e.preventDefault()
          openEd()
        }
      })
      function isDark() {
        return document.documentElement.dataset.theme
          ? document.documentElement.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches
      }
      function toggleTheme() {
        var next = isDark() ? "light" : "dark"
        var apply = function () {
          document.documentElement.dataset.theme = next
          var th = document.getElementById("theme")
          if (th) th.setAttribute("aria-pressed", String(next === "dark"))
        }
        if (document.startViewTransition) document.startViewTransition(apply)
        else apply()
        try { localStorage.setItem("nabiz-theme", next) } catch {}
      }
      wire()
      if (location.hash === "#notice") openEd()
      // A link to /#notice from a page already open is a fragment change
      // and nothing else; without this it does nothing at all.
      addEventListener("hashchange", function () { if (location.hash === "#notice") openEd() })

      // The future does not reload: the page refetches itself and morphs,
      // with a view transition where the browser has one.
      function refresh() {
        if (dlg.open) return
        var was = (document.querySelector(".hero-s") || {}).textContent
        var seat = mark(document.activeElement)
        fetch(location.pathname + location.search, { headers: { "x-refresh": "1" } })
          .then(function (r) { return r.text() })
          .then(function (html) {
            // Opened while this was in flight: replacing the body now takes
            // the editor and whatever was typed into it with it.
            if (dlg.open) return
            var next = new DOMParser().parseFromString(html, "text/html")
            var incoming = next.getElementById("say")
            if (incoming) incoming.remove()
            var swap = function () {
              document.body.replaceChildren.apply(document.body, Array.prototype.slice.call(next.body.childNodes))
              if (live && !live.isConnected) document.body.insertBefore(live, document.querySelector("main"))
              wire()
              sit(seat)
              say(was)
            }
            if (document.startViewTransition) document.startViewTransition(swap)
            else swap()
          })
          .catch(function () {})
      }
      function stops() {
        return Array.prototype.slice.call(document.querySelectorAll("a[href],button,select,input,textarea"))
      }
      /** What the focused element was, in three descriptions: the page is
       *  rebuilt from new nodes, and its shape changes when a panel comes
       *  or goes — so a position in the tab order is the last resort, not
       *  the first. */
      function mark(el) {
        if (!el || el === document.body) return null
        var href = el.getAttribute ? el.getAttribute("href") || "" : ""
        var usable = href.indexOf('"') < 0 && href.indexOf("\\") < 0
        return { id: el.id || "", href: usable ? href : "", at: stops().indexOf(el) }
      }
      function sit(seat) {
        if (!seat) return
        var back = seat.id ? document.getElementById(seat.id) : null
        if (!back && seat.href) {
          // The same href is in a panel header and in the footer; the one
          // that had the focus is the one nearest where the focus was.
          var same = Array.prototype.slice.call(document.querySelectorAll('a[href="' + seat.href + '"]'))
          var all = stops()
          same.forEach(function (el) {
            if (!back || Math.abs(all.indexOf(el) - seat.at) < Math.abs(all.indexOf(back) - seat.at)) back = el
          })
        }
        if (!back && seat.at >= 0) back = stops()[seat.at]
        if (back && back.focus) back.focus()
      }
      /** Nothing else announces: the page rewrites itself in place, so a
       *  reader hears the outage end only if it is said. */
      function say(was) {
        var now = (document.querySelector(".hero-s") || {}).textContent
        if (!live || !now || now === was) return
        setTimeout(function () { live.textContent = now }, 60)
      }
      setInterval(refresh, 25000)
      addEventListener("visibilitychange", function () { if (!document.hidden) refresh() })
    </script>
  </body>
</html>
